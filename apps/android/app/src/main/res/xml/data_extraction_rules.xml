<?xml version="1.0" encoding="utf-8"?>
<!--
  Backup and device-transfer are disabled app-wide (android:allowBackup="false").

  This app will hold provider credentials and an on-device session database
  (M7/M10). Until that data has an explicit, reviewed backup posture, exporting
  none of it is the correct default.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
