<?xml version="1.0" encoding="utf-8"?>
<!--
  The API 26-30 counterpart of data_extraction_rules.xml.

  android:allowBackup="false" already disables backup on every supported version,
  so this is defence in depth rather than the primary control — but for an app
  that will hold provider credentials and a session database, defence in depth is
  the right default.
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="file" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="external" path="." />
</full-backup-content>
