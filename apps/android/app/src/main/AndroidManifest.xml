<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      PERMISSIONS: none.

      M2 renders a page bundled in the APK. No network, no storage, no sensors.
      Every permission added later must be justified in a comment here and must
      pass scripts/ci/verify-apk.sh, which fails the build on a forbidden one.

      Deliberately NOT requested, now or later without an ADR:
        MANAGE_EXTERNAL_STORAGE  - project folders use the Storage Access
                                   Framework instead (.claude/rules/android.md N4)
        REQUEST_INSTALL_PACKAGES - the app never installs anything

      Expected additions:
        FOREGROUND_SERVICE- M7, to keep an agent turn alive while backgrounded
    -->

    <!--
      INTERNET (M5): reaching the OpenCode server the user configures, and
      through it the AI providers.

      Note that this is NOT needed for the M7 end state on its own - a server on
      loopback is reachable without it - but the providers the server talks to
      are remote, and in M5 the server itself is.
    -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      ACCESS_NETWORK_STATE (M5): lets the app tell "you are offline" apart from
      "that server is down", so a connection failure can say which it was.
    -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!--
      POST_NOTIFICATIONS (M4): backs Platform.notify, which the shared UI uses to
      tell the user a long-running agent turn finished while they were elsewhere.

      Only meaningful from API 33; below that, posting needs no permission. It is
      requested at runtime, once, and a refusal degrades notifications rather than
      blocking the app - Notifications.post reports the refusal instead of
      pretending to have posted.
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <application
        android:name=".OpenCodeApplication"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.OpenCode"
        android:enableOnBackInvokedCallback="true">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|uiMode|density|fontScale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
